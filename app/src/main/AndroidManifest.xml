<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice capture for the assistant overlay (step 5) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notify the user when the model answers while the app is backgrounded -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- set_alarm / set_timer via AlarmClock intents (normal permission) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- add_calendar_event: DIRECT save mode (runtime permission) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- get_location / open_map tools -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- open_map resolves geo: URIs; visible map apps are queried at runtime -->


    <!-- API 30+: without these <queries> the system speech recognizer is
         invisible to the app and SpeechRecognizer fails with a client
         error even when the Google app is installed. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- add_calendar_event: calendar apps must be visible (API 30+) -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- open_map: Organic Maps / woheller69 maps / OsmAnd (geo: URIs) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:label="AndroidAssist"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AndroidAssist">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The "bloquinho": bottom-sheet assistant for the system
             assistant gesture / long-press home -->
        <activity
            android:name=".ui.CompactAssistantActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.AndroidAssist.Overlay"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
